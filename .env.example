# Copy to .env (or set these in your hosting dashboard). Never commit the real values.
NODE_ENV=production
PORT=3000
# Long random string, e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# The administrator login for the website (min 10 characters). There are no built-in/demo accounts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Where the database and uploaded photos are stored. Put this on a persistent disk.
DATA_DIR=./data
