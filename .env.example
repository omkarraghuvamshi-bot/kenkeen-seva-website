# Render environment variables
NODE_ENV=production
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Neon PostgreSQL connection string (include ?sslmode=require if Neon provides it)
DATABASE_URL=

# Admin account created/updated at service startup
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary dashboard: Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
